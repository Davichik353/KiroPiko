<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: this file is merged into the debug variant and into no other, so a release build has no preview receiver. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- ADB shell has DUMP; ordinary apps must not replace live widgets with preview data. -->
        <receiver android:name=".app.WidgetPreviewReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.coucou.android.debug.WIDGET_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

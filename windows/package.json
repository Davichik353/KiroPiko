{
  "name": "kiropiko-windows",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "check:preserved": "node scripts/check-coucou-preserved.mjs",
    "native:check": "powershell -NoProfile -File scripts/native-windows.ps1 -Action check",
    "native:test": "powershell -NoProfile -File scripts/native-windows.ps1 -Action test",
    "native:dev": "powershell -NoProfile -File scripts/native-windows.ps1 -Action dev",
    "native:build": "powershell -NoProfile -File scripts/native-windows.ps1 -Action build",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "hook:build": "cargo build --release -p coucou-hook",
    "sounds": "node scripts/gen-nova-sounds.mjs",
    "pack": "tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
